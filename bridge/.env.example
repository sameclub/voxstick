# VoxStick bridge configuration. Copy to bridge/.env and fill in.
# Empty values mean "use the built-in default". Never commit real secrets.

# --- required when the device talks to the bridge over Wi-Fi ---
# The bridge refuses to bind outside loopback without a token.
# Generate one: python -c "import secrets;print(secrets.token_hex(32))"
# The same value goes into bridge_token in /voxstick.ini on the TF card.
VOX_STICK_BRIDGE_TOKEN=

# --- Tencent Cloud ASR (SentenceRecognition, https://cloud.tencent.com/document/api/1093/35646) ---
# Console -> 访问管理 -> API 密钥管理. The ASR service must be enabled on the account.
VOX_STICK_TENCENT_SECRET_ID=
VOX_STICK_TENCENT_SECRET_KEY=
# 16k_zh (Mandarin), 16k_zh_dialect, 16k_en, 16k_yue, 16k_ja ...
VOX_STICK_ASR_ENGINE=16k_zh
VOX_STICK_ASR_TIMEOUT_SECONDS=15
VOX_STICK_ASR_ATTEMPTS=2

# --- agents ---
# auto | codex | claude
VOX_STICK_PROVIDER=auto
# Claude 5H/7D usage is off by default; it calls an undocumented Claude Code
# OAuth endpoint with your local credentials.
VOX_STICK_CLAUDE_USAGE=off
VOX_STICK_CLAUDE_USAGE_INTERVAL_SECONDS=300
CLAUDE_CODE_OAUTH_TOKEN=
VOX_STICK_PROJECT_ROOT=
VOX_STICK_PROJECT_NAME=

# --- recording ---
# 1.8 MB = 56 s of 16 kHz mono 16-bit PCM, the device's recording cap.
VOX_STICK_MAX_RECORDING_AUDIO_BYTES=1800000
# Press Return after pasting the transcript.
VOX_STICK_AUTO_ENTER=0

# --- optional: offline or custom ASR ---
# Receives the recording session JSON on stdin, prints the transcript on stdout.
# Takes priority over Tencent when set.
VOX_STICK_TRANSCRIBE_CMD=
VOX_STICK_TRANSCRIBE_TIMEOUT_SECONDS=120
# Shell hooks around a take; a host-microphone fallback can be wired here.
VOX_STICK_RECORDING_START_CMD=
VOX_STICK_RECORDING_STOP_CMD=
